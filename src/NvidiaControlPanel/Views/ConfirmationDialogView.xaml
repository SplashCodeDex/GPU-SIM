<Window x:Class="NvidiaControlPanel.Views.ConfirmationDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NVIDIA Control Panel" 
        Height="180" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0"
        Icon="pack://application:,,,/icon.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Your desktop has been reconfigured. Do you want to keep these changes?" 
                       TextWrapping="Wrap" 
                       Foreground="#333333"
                       FontSize="14"/>
            <TextBlock x:Name="TimerText" 
                       Text="Reverting in 15 seconds" 
                       Margin="0,10,0,0"
                       Foreground="#666666"
                       FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="YesButton" Content="Yes" Width="80" Margin="0,0,10,0" IsDefault="True" Click="YesButton_Click"/>
            <Button x:Name="NoButton" Content="No" Width="80" IsCancel="True" Click="NoButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
