<UserControl x:Class="NvidiaControlPanel.Views.ConfigureSurroundPhysXView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NvidiaControlPanel.Views"
             xmlns:viewmodels="clr-namespace:NvidiaControlPanel.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:ConfigureSurroundPhysXViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Set a PhysX Configuration"
                   Style="{StaticResource SectionHeaderStyle}"
                   Grid.Row="0" Margin="0,0,0,20"/>

        <!-- PhysX Settings -->
        <GroupBox Header="PhysX settings" Grid.Row="1" Margin="0,0,0,20" BorderBrush="#D0D0D0">
            <StackPanel Margin="10">
                <TextBlock Text="Processor:" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding PhysXProcessors}"
                          SelectedItem="{Binding SelectedPhysXProcessor}"
                          Width="250" HorizontalAlignment="Left" Margin="0,0,0,15"/>

                <TextBlock Text="Description:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="Select a graphics processor for PhysX acceleration."
                           TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{StaticResource NvidiaDarkGreyBrush}"/>

                <!-- Visual Diagram Shim (Placeholder for complex diagram) -->
                <Border Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" Height="150" Margin="0,10,0,0">
                    <Grid>
                        <TextBlock Text="[PhysX Visual Indicator Area]"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#999999"/>
                        <!-- In a real implementation, this would be a dynamic canvas drawing the GPU/CPU link -->
                    </Grid>
                </Border>
            </StackPanel>
        </GroupBox>

        <!-- Surround Settings -->
        <GroupBox Header="Surround configuration" Grid.Row="2" BorderBrush="#D0D0D0" VerticalAlignment="Top">
             <StackPanel Margin="10">
                <CheckBox Content="Span displays with Surround"
                          IsChecked="{Binding IsSurroundEnabled}"
                          Margin="0,0,0,10"/>

                <TextBlock Text="Configure..."
                           Foreground="Blue"
                           TextDecorations="Underline"
                           Cursor="Hand"
                           Visibility="{Binding IsSurroundEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
             </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
