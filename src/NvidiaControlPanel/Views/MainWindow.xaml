<Window x:Class="NvidiaControlPanel.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:views="clr-namespace:NvidiaControlPanel.Views"
        xmlns:viewModels="clr-namespace:NvidiaControlPanel.ViewModels"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="NVIDIA Control Panel" Height="700" Width="1100"
        Icon="pack://application:,,,/icon.ico"
        Background="#F0F0F0">
<!-- Standard Nvidia-ish Style for TreeView is now GLOBAL in App.xaml -->
    <Window.Resources>
        <!-- View Mapping -->
        <!-- View Mappings moved to App.xaml -->

        <!-- Menu Style -->
        <Style TargetType="MenuItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel Background="{StaticResource BackgroundBrush}">
            <!-- Menu Bar -->
            <Menu DockPanel.Dock="Top" Background="{StaticResource BackgroundBrush}" Padding="5">
                <MenuItem Header="_File">
                    <MenuItem Header="_Home" Command="{Binding NavigateCommand}" CommandParameter="Home"/>
                    <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
                </MenuItem>
                <MenuItem Header="_Edit"/>
                <MenuItem Header="_Desktop">
                    <MenuItem Header="Add Desktop Context Menu"
                              IsCheckable="True"
                              IsChecked="{Binding IsContextMenuEnabled}"
                              Command="{Binding ToggleContextMenuCommand}"/>
                    <MenuItem Header="Show Notification Tray Icon" 
                              IsCheckable="True" 
                              IsChecked="{Binding IsTrayIconVisible}"
                              Command="{Binding ToggleTrayIconCommand}"/>
                    <MenuItem Header="Enable Persistence (Auto-Start with Windows)" 
                              IsCheckable="True" 
                              IsChecked="{Binding IsAutoStartEnabled}"
                              Command="{Binding ToggleAutoStartCommand}"/>
                </MenuItem>
                <MenuItem Header="_3D Settings"/>
                <MenuItem Header="_Help">
                    <MenuItem Header="System _Information" Command="{Binding ShowSystemInfoCommand}"/>
                </MenuItem>
            </Menu>

            <!-- Tool Bar (Modernized) -->
            <Border DockPanel.Dock="Top" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,5">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Width="40" Margin="0,0,5,0" 
                                Command="{Binding BackCommand}"
                                ToolTip="{Binding BackTooltip}"
                                Style="{StaticResource BaseControlStyle}" Background="Transparent">
                            <iconPacks:PackIconMaterial Kind="ArrowLeft" Width="16" Height="16">
                                <iconPacks:PackIconMaterial.Style>
                                    <Style TargetType="iconPacks:PackIconMaterial">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                                <Setter Property="Opacity" Value="0.5"/>
                                                <Setter Property="Effect" Value="{x:Null}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                                <Setter Property="Opacity" Value="1.0"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="{StaticResource Color_NvidiaGreen}" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="Foreground" Value="{StaticResource NvidiaGreenBrush}"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </iconPacks:PackIconMaterial.Style>
                            </iconPacks:PackIconMaterial>
                        </Button>
                        <Button Width="40" 
                                Command="{Binding ForwardCommand}"
                                ToolTip="{Binding ForwardTooltip}"
                                Style="{StaticResource BaseControlStyle}" Background="Transparent">
                            <iconPacks:PackIconMaterial Kind="ArrowRight" Width="16" Height="16">
                                <iconPacks:PackIconMaterial.Style>
                                    <Style TargetType="iconPacks:PackIconMaterial">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                                <Setter Property="Opacity" Value="0.5"/>
                                                <Setter Property="Effect" Value="{x:Null}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                                <Setter Property="Opacity" Value="1.0"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="{StaticResource Color_NvidiaGreen}" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="Foreground" Value="{StaticResource NvidiaGreenBrush}"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </iconPacks:PackIconMaterial.Style>
                            </iconPacks:PackIconMaterial>
                        </Button>
                        <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="5,5"/>
                        
                        <!-- Dynamic Breadcrumbs -->
                        <ItemsControl ItemsSource="{Binding CurrentPathSegments}" VerticalAlignment="Center" Margin="5,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,5,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" From="10,0,5,0" To="0,0,5,0" Duration="0:0:0.3">
                                                                    <ThicknessAnimation.EasingFunction>
                                                                        <PowerEase EasingMode="EaseOut"/>
                                                                    </ThicknessAnimation.EasingFunction>
                                                                </ThicknessAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status Bar -->
            <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Height="30" Padding="10,0">
                <StatusBarItem>
                    <TextBlock Text="{Binding StatusBarText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                </StatusBarItem>
            </StatusBar>

            <!-- Main Content (Split View) -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Pane: Navigation Tree -->
                <Border Grid.Column="0" Background="{StaticResource BackgroundAltBrush}" Margin="10,0,0,10" CornerRadius="4">
                    <Grid>
                        <!-- Background Noise for TreeView -->
                        <Rectangle Fill="{StaticResource NoiseBrush}" Opacity="0.5" IsHitTestVisible="False"/>
                        <TreeView BorderThickness="0" Background="Transparent" Padding="5">
                        <TreeViewItem IsExpanded="True" IsSelected="True" FontWeight="Bold">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Home" VerticalAlignment="Center" Margin="0,0,8,0" Width="16" Height="16"/>
                                    <TextBlock Text="Home" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TreeViewItem.Header>
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="Selected">
                                    <b:InvokeCommandAction Command="{Binding NavigateCommand}" CommandParameter="Home"/>
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </TreeViewItem>

                        <TreeViewItem IsExpanded="True" FontWeight="Bold">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="CubeOutline" VerticalAlignment="Center" Margin="0,0,8,0" Width="16" Height="16"/>
                                    <TextBlock Text="3D Settings" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TreeViewItem.Header>
                            <TreeViewItem>
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Image" VerticalAlignment="Center" Margin="0,0,8,0" Width="14" Height="14"/>
                                        <TextBlock Text="Adjust image settings with preview" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TreeViewItem.Header>
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="Selected">
                                        <b:InvokeCommandAction Command="{Binding NavigateCommand}" CommandParameter="AdjustImageSettings"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TreeViewItem>
                            <TreeViewItem>
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Cog" VerticalAlignment="Center" Margin="0,0,8,0" Width="14" Height="14"/>
                                        <TextBlock Text="Manage 3D settings" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TreeViewItem.Header>
                                 <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="Selected">
                                        <b:InvokeCommandAction Command="{Binding NavigateCommand}" CommandParameter="Manage3DSettings"/>
                                    </b:EventTrigger>
                                 </b:Interaction.Triggers>
                            </TreeViewItem>
                            <TreeViewItem>
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="VectorCircle" VerticalAlignment="Center" Margin="0,0,8,0" Width="14" Height="14"/>
                                        <TextBlock Text="Configure Surround, PhysX" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TreeViewItem.Header>
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="Selected">
                                        <b:InvokeCommandAction Command="{Binding NavigateCommand}" CommandParameter="ConfigureSurroundPhysX"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TreeViewItem>
                        </TreeViewItem>
                        <TreeViewItem IsExpanded="True" FontWeight="Bold">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Monitor" VerticalAlignment="Center" Margin="0,0,8,0" Width="16" Height="16"/>
                                    <TextBlock Text="Display" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TreeViewItem.Header>
                            <TreeViewItem>
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="MonitorScreenshot" VerticalAlignment="Center" Margin="0,0,8,0" Width="14" Height="14"/>
                                        <TextBlock Text="Change resolution" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TreeViewItem.Header>
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="Selected">
                                        <b:InvokeCommandAction Command="{Binding NavigateCommand}" CommandParameter="ChangeResolution"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TreeViewItem>
                            <TreeViewItem>
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Palette" VerticalAlignment="Center" Margin="0,0,8,0" Width="14" Height="14"/>
                                        <TextBlock Text="Adjust desktop color settings" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TreeViewItem.Header>
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="Selected">
                                        <b:InvokeCommandAction Command="{Binding NavigateCommand}" CommandParameter="AdjustDesktopColor"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TreeViewItem>
                            <TreeViewItem>
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="RotateRight" VerticalAlignment="Center" Margin="0,0,8,0" Width="14" Height="14"/>
                                        <TextBlock Text="Rotate display" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TreeViewItem.Header>
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="Selected">
                                        <b:InvokeCommandAction Command="{Binding NavigateCommand}" CommandParameter="RotateDisplay"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TreeViewItem>
                            <TreeViewItem>
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="LockCheck" VerticalAlignment="Center" Margin="0,0,8,0" Width="14" Height="14"/>
                                        <TextBlock Text="View HDCP status" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TreeViewItem.Header>
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="Selected">
                                        <b:InvokeCommandAction Command="{Binding NavigateCommand}" CommandParameter="ViewHDCPStatus"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TreeViewItem>
                            <TreeViewItem>
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Speaker" VerticalAlignment="Center" Margin="0,0,8,0" Width="14" Height="14"/>
                                        <TextBlock Text="Set up digital audio" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TreeViewItem.Header>
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="Selected">
                                        <b:InvokeCommandAction Command="{Binding NavigateCommand}" CommandParameter="SetupDigitalAudio"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TreeViewItem>
                            <TreeViewItem>
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Resize" VerticalAlignment="Center" Margin="0,0,8,0" Width="14" Height="14"/>
                                        <TextBlock Text="Adjust desktop size and position" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TreeViewItem.Header>
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="Selected">
                                        <b:InvokeCommandAction Command="{Binding NavigateCommand}" CommandParameter="AdjustDesktopSizePosition"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TreeViewItem>
                            <TreeViewItem>
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="MonitorMultiple" VerticalAlignment="Center" Margin="0,0,8,0" Width="14" Height="14"/>
                                        <TextBlock Text="Set up multiple displays" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TreeViewItem.Header>
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="Selected">
                                        <b:InvokeCommandAction Command="{Binding NavigateCommand}" CommandParameter="SetupMultipleDisplays"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TreeViewItem>
                        </TreeViewItem>
                        <TreeViewItem IsExpanded="True" FontWeight="Bold">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Video" VerticalAlignment="Center" Margin="0,0,8,0" Width="16" Height="16"/>
                                    <TextBlock Text="Video" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TreeViewItem.Header>
                            <TreeViewItem>
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="PaletteAdvanced" VerticalAlignment="Center" Margin="0,0,8,0" Width="14" Height="14"/>
                                        <TextBlock Text="Adjust video color settings" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TreeViewItem.Header>
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="Selected">
                                        <b:InvokeCommandAction Command="{Binding NavigateCommand}" CommandParameter="AdjustVideoColor"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TreeViewItem>
                            <TreeViewItem>
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ImageEdit" VerticalAlignment="Center" Margin="0,0,8,0" Width="14" Height="14"/>
                                        <TextBlock Text="Adjust video image settings" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TreeViewItem.Header>
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="Selected">
                                        <b:InvokeCommandAction Command="{Binding NavigateCommand}" CommandParameter="AdjustVideoImage"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TreeViewItem>
                        </TreeViewItem>
                    </TreeView>
                    </Grid>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="Transparent" Margin="5,0"/>

                <!-- Right Pane: Content -->
                <Border Grid.Column="2" Background="{StaticResource BackgroundBrush}" Margin="0,0,10,10">
                    <Grid>
                        <!-- Background Noise -->
                        <Rectangle Fill="{StaticResource NoiseBrush}" Opacity="0.3" IsHitTestVisible="False"/>
                        
                        <!-- Background Watermark -->
                        <Image Source="pack://application:,,,/Resources/Images/nvidia_logo_2.png"
                               Opacity="0.15"
                               Width="500"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Right"
                               IsHitTestVisible="False"/>

                        <ContentControl Content="{Binding CurrentView}"/>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>

        <!-- GTX Logo Overlay -->
        <Image Source="pack://application:,,,/Resources/Images/geforce_gtx_logo.png"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Height="165"
               Margin="2,30,8,0"
               IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality"/>
    </Grid>
</Window>
