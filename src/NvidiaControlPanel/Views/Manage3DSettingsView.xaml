<UserControl x:Class="NvidiaControlPanel.Views.Manage3DSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:NvidiaControlPanel.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:Manage3DSettingsViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="I would like to use the following 3D settings:"
                   Foreground="{StaticResource PrimaryTextBrush}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="10,15,10,10"/>

        <!-- Tabs (Global vs Program) -->
        <TabControl Grid.Row="1" Margin="10,0,10,10" BorderThickness="0" Background="Transparent">
            <!-- Note: Standard TabItem style will be used. For a clearer look, we might want a custom style later. -->
            <TabItem Header="Global Settings" IsSelected="True" Background="Transparent">
                <StackPanel Margin="0,15,0,0">
                    <TextBlock Text="Global Presets:" Margin="0,0,0,5" Foreground="{StaticResource PrimaryTextBrush}"/>
                    <ComboBox SelectedIndex="0" Width="300" HorizontalAlignment="Left" Style="{StaticResource {x:Type ComboBox}}">
                        <ComboBoxItem Content="Base profile"/>
                        <ComboBoxItem Content="High Performance"/>
                        <ComboBoxItem Content="Workstation App - Dynamic Streaming"/>
                    </ComboBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Program Settings" Background="Transparent">
                <StackPanel Margin="0,15,0,0">
                    <TextBlock Text="Select a program to customize:" Margin="0,0,0,5" Foreground="{StaticResource PrimaryTextBrush}"/>
                     <ComboBox Width="300" HorizontalAlignment="Left"
                               ItemsSource="{Binding Programs}"
                               SelectedItem="{Binding SelectedProgram}"
                               IsEnabled="True"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Settings List -->
        <!-- Style is now implicit from App.xaml -->
        <!-- Settings List -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="10,0,10,10" Background="White">
            <ListView ItemsSource="{Binding Settings}"
                      HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      BorderThickness="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E5E5E5"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E5F3FF"/> <!-- Light Blue/Green selection tint -->
                                <Setter Property="BorderBrush" Value="{StaticResource NvidiaGreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F7F7F7"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Feature" Width="380">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Padding="5" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsModified}" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="Black"/> <!-- Darker when modified -->
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsModified}" Value="False">
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Setting" Width="280">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Options}"
                                              SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource {x:Type ComboBox}}"
                                              Margin="2"
                                              HorizontalAlignment="Stretch">
                                        <!-- Custom ComboBox Item Styling if needed -->
                                    </ComboBox>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Bottom Description Area -->
        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="10,0,10,10" Height="80" CornerRadius="4" Background="{StaticResource BackgroundAltBrush}">
            <ScrollViewer>
                <TextBlock Text="Description of the selected feature (coming soon)."
                           TextWrapping="Wrap"
                           Padding="10"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,20">
            <Button Content="Restore" Command="{Binding RestoreDefaultsCommand}" Width="100" Margin="0,0,10,0"
                    Background="Transparent" Foreground="{StaticResource NvidiaGreenBrush}" BorderBrush="{StaticResource NvidiaGreenBrush}" BorderThickness="1"/>
            <Button Content="Apply" Command="{Binding ApplyCommand}" Width="100"/>
        </StackPanel>
    </Grid>
</UserControl>
