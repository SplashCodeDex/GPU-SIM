<Window x:Class="NvidiaControlPanel.Views.SystemInfoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:NvidiaControlPanel.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:SystemInfoViewModel}"
        Title="System Information" Height="500" Width="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        Icon="pack://application:,,,/icon.ico">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="White" BorderBrush="#D9D9D9" BorderThickness="0,0,0,1" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Source="pack://application:,,,/Resources/Images/nvidia_logo_full.png"
                       Grid.Column="0"
                       Width="150"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="System Information" FontSize="20" FontWeight="SemiBold" Foreground="#333333"/>
                    <TextBlock Text="Display" FontSize="14" Foreground="#76b900" Margin="0,5,0,0" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Padding="20">
                <StackPanel>
                    <TextBlock Text="Items:" FontWeight="Bold" Margin="0,0,0,10"/>

                    <Border BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
                        <StackPanel>
                            <!-- Header Row -->
                            <Grid Background="#E5E5E5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Feature" FontWeight="Bold" Padding="10"/>
                                <TextBlock Grid.Column="1" Text="Details" FontWeight="Bold" Padding="10"/>
                            </Grid>

                            <!-- GPU Name -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="GPU" Padding="10"/>
                                <TextBlock Grid.Column="1" Text="{Binding GpuName}" Padding="10"/>
                            </Grid>
                            <Separator Background="#EEEEEE"/>

                            <!-- Driver Version -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Driver version" Padding="10"/>
                                <TextBlock Grid.Column="1" Text="{Binding DriverVersion}" Padding="10"/>
                            </Grid>
                            <Separator Background="#EEEEEE"/>

                            <!-- Video Memory -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dedicated video memory" Padding="10"/>
                                <TextBlock Grid.Column="1" Text="{Binding VideoMemory}" Padding="10"/>
                            </Grid>
                            <Separator Background="#EEEEEE"/>

                            <!-- Fake Details for Illusion -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="DirectX runtime version" Padding="10"/>
                                <TextBlock Grid.Column="1" Text="12.0" Padding="10"/>
                            </Grid>
                            <Separator Background="#EEEEEE"/>

                            <Grid>
                                 <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Bus" Padding="10"/>
                                <TextBlock Grid.Column="1" Text="PCI Express x16 Gen3" Padding="10"/>
                            </Grid>

                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#F0F0F0" Padding="10,10,20,10">
            <Button Content="Close"
                    Command="{Binding CloseCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Width="80"
                    Height="24"
                    HorizontalAlignment="Right"
                    Style="{DynamicResource BaseControlStyle}"/>
        </Border>
    </Grid>
</Window>
