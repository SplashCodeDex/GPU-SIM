<Window x:Class="NvidiaControlPanel.Views.FakeUpdateView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:NvidiaControlPanel.ViewModels"
        mc:Ignorable="d"
        Title="NVIDIA Web Helper" Height="250" Width="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        Icon="pack://application:,,,/icon.ico"
        Topmost="True">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="NVIDIA Software Update" FontSize="16" FontWeight="Bold" Foreground="#333333"/>
            <TextBlock Text="{Binding StatusMessage}" Margin="0,5,0,0" Foreground="#666666"/>
        </StackPanel>

        <!-- Progress Area -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <ProgressBar Height="20" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" 
                         Visibility="{Binding IsErrorVisible, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
            
            <!-- Error Message -->
            <Border Background="#FFF0F0" BorderBrush="#FFCCCC" BorderThickness="1" Padding="10" CornerRadius="4"
                    Visibility="{Binding IsErrorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Connection to NVIDIA update server timed out." 
                               Foreground="#CC0000" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="Please visit the official website and download the latest driver manually." 
                               Margin="0,5,0,0" FontSize="12" Foreground="#333333" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Width="80" IsCancel="True" Command="{Binding CloseCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource BaseControlStyle}"/>
        </StackPanel>
    </Grid>
</Window>
