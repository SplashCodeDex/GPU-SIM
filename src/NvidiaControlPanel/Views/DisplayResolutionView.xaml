<UserControl x:Class="NvidiaControlPanel.Views.DisplayResolutionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:NvidiaControlPanel.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:DisplayResolutionViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Change Resolution"
                   Foreground="{StaticResource PrimaryTextBrush}"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="10,15,10,10"/>

        <TextBlock Grid.Row="1"
                   Text="Select the resolution you want to use for your display:"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Margin="10,0,10,15"/>

        <!-- Resolution Selection Area -->
        <Grid Grid.Row="2" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Resolutions List -->
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="Resolution:" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                    <ListBox ItemsSource="{Binding Resolutions}"
                             SelectedItem="{Binding SelectedResolution}"
                             BorderThickness="0"
                             Background="Transparent"
                             Height="250">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" Padding="10,5"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>

            <!-- Refresh Rate -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Refresh rate:" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <ComboBox ItemsSource="{Binding RefreshRates}"
                          SelectedItem="{Binding SelectedRefreshRate}"
                          Width="150" HorizontalAlignment="Left"/>
            </StackPanel>
        </Grid>

        <!-- Bottom Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,20">
            <Button Content="Restore" Width="100" Margin="0,0,10,0"
                    Background="Transparent" Foreground="{StaticResource NvidiaGreenBrush}" BorderBrush="{StaticResource NvidiaGreenBrush}" BorderThickness="1"/>
            <Button Content="Apply" Command="{Binding ApplyCommand}" Width="100"/>
        </StackPanel>
    </Grid>
</UserControl>
