<UserControl x:Class="NvidiaControlPanel.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:NvidiaControlPanel.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:HomeViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="NVIDIA Control Panel"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Margin="0,0,0,20"/>

            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="20">
                <StackPanel>
                    <TextBlock Text="Graphics Card Information"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource NvidiaGreenBrush}"
                               Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="GPU:" Grid.Row="0" Grid.Column="0" Margin="0,5" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding GpuName}" Grid.Row="0" Grid.Column="1" Margin="0,5"/>

                        <TextBlock Text="Driver Version:" Grid.Row="1" Grid.Column="0" Margin="0,5" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DriverVersion}" Grid.Row="1" Grid.Column="1" Margin="0,5"/>

                        <TextBlock Text="Dedicated Video Memory:" Grid.Row="2" Grid.Column="0" Margin="0,5" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding VideoMemory}" Grid.Row="2" Grid.Column="1" Margin="0,5"/>

                        <TextBlock Text="Bus Support:" Grid.Row="3" Grid.Column="0" Margin="0,5" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding BusSupport}" Grid.Row="3" Grid.Column="1" Margin="0,5"/>

                        <TextBlock Text="BIOS Version:" Grid.Row="4" Grid.Column="0" Margin="0,5" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding BiosVersion}" Grid.Row="4" Grid.Column="1" Margin="0,5"/>

                        <TextBlock Text="DirectX Support:" Grid.Row="5" Grid.Column="0" Margin="0,5" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DirectXSupport}" Grid.Row="5" Grid.Column="1" Margin="0,5"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Use the tree on the left to navigate through the various settings."
                       Margin="0,20,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
