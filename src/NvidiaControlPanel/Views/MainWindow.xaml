<Window x:Class="NvidiaControlPanel.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:views="clr-namespace:NvidiaControlPanel.Views"
        xmlns:viewModels="clr-namespace:NvidiaControlPanel.ViewModels"
        mc:Ignorable="d"
        Title="NVIDIA Control Panel" Height="700" Width="1100"
        Icon="pack://application:,,,/icon.ico"
        Background="#F0F0F0">
<!-- Standard Nvidia-ish Style for TreeView is now GLOBAL in App.xaml -->
    <Window.Resources>
        <!-- View Mapping -->
        <DataTemplate DataType="{x:Type viewModels:Manage3DSettingsViewModel}">
            <views:Manage3DSettingsView/>
        </DataTemplate>

        <!-- Menu Style -->
        <Style TargetType="MenuItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="{StaticResource BackgroundBrush}">
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource BackgroundBrush}" Padding="5">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Edit"/>
            <MenuItem Header="_Desktop">
                <MenuItem Header="Add Desktop Context Menu"
                          IsCheckable="True"
                          IsChecked="{Binding IsContextMenuEnabled}"
                          Command="{Binding ToggleContextMenuCommand}"/>
                <MenuItem Header="Show Notification Tray Icon" IsCheckable="True" IsChecked="True"/>
            </MenuItem>
            <MenuItem Header="_3D Settings"/>
            <MenuItem Header="_Help">
                <MenuItem Header="System _Information" Command="{Binding ShowSystemInfoCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Tool Bar (Modernized) -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,5">
            <StackPanel Orientation="Horizontal">
                <Button Content="Back" Width="60" Margin="0,0,5,0" IsEnabled="False" Style="{StaticResource BaseControlStyle}" Background="Transparent" Foreground="{StaticResource SecondaryTextBrush}"/>
                <Button Content="Forward" Width="80" IsEnabled="False" Style="{StaticResource BaseControlStyle}" Background="Transparent" Foreground="{StaticResource SecondaryTextBrush}"/>
                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="10,2"/>
                <TextBlock Text="Standard Tasks" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Height="30" Padding="10,0">
            <StatusBarItem>
                <TextBlock Text="System Information: NVIDIA GeForce GTX 1650" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content (Split View) -->
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Navigation Tree -->
            <Border Grid.Column="0" Background="{StaticResource BackgroundAltBrush}" Margin="10,0,0,10" CornerRadius="4">
                <TreeView BorderThickness="0" Background="Transparent" Padding="5">
                    <TreeViewItem Header="3D Settings" IsExpanded="True" FontWeight="Bold">
                        <TreeViewItem Header="Adjust image settings with preview"/>
                        <TreeViewItem Header="Manage 3D settings" IsSelected="True">
                             <b:Interaction.Triggers>
                                <b:EventTrigger EventName="Selected">
                                    <b:InvokeCommandAction Command="{Binding NavigateCommand}" CommandParameter="Manage3DSettings"/>
                                </b:EventTrigger>
                             </b:Interaction.Triggers>
                        </TreeViewItem>
                        <TreeViewItem Header="Configure Surround, PhysX"/>
                    </TreeViewItem>
                    <TreeViewItem Header="Display" IsExpanded="True" FontWeight="Bold">
                        <TreeViewItem Header="Change resolution"/>
                        <TreeViewItem Header="Adjust desktop color settings"/>
                        <TreeViewItem Header="Rotate display"/>
                        <TreeViewItem Header="View HDCP status"/>
                        <TreeViewItem Header="Set up digital audio"/>
                        <TreeViewItem Header="Adjust desktop size and position"/>
                        <TreeViewItem Header="Set up multiple displays"/>
                    </TreeViewItem>
                    <TreeViewItem Header="Video" IsExpanded="True" FontWeight="Bold">
                        <TreeViewItem Header="Adjust video color settings"/>
                        <TreeViewItem Header="Adjust video image settings"/>
                    </TreeViewItem>
                </TreeView>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="Transparent" Margin="5,0"/>

            <!-- Right Pane: Content -->
            <Border Grid.Column="2" Background="{StaticResource BackgroundBrush}" Margin="0,0,10,10">
                <ContentControl Content="{Binding CurrentView}"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
