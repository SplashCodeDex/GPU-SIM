<Window x:Class="NvidiaControlPanel.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:views="clr-namespace:NvidiaControlPanel.Views"
        xmlns:viewModels="clr-namespace:NvidiaControlPanel.ViewModels"
        mc:Ignorable="d"
        Title="NVIDIA Control Panel" Height="700" Width="1100"
        Icon="pack://application:,,,/icon.ico"
        Background="#F0F0F0">
    <Window.Resources>
        <!-- Standard Nvidia-ish Style for TreeView -->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource NvidiaDarkGreyBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource NvidiaGreenBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- View Mapping -->
        <DataTemplate DataType="{x:Type viewModels:Manage3DSettingsViewModel}">
            <views:Manage3DSettingsView/>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource NvidiaWhiteBrush}" BorderBrush="{StaticResource NvidiaDarkGreyBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Edit"/>
            <MenuItem Header="_Desktop">
                <MenuItem Header="Add Desktop Context Menu"
                          IsCheckable="True"
                          IsChecked="{Binding IsContextMenuEnabled}"
                          Command="{Binding ToggleContextMenuCommand}"/>
                <MenuItem Header="Show Notification Tray Icon" IsCheckable="True" IsChecked="True"/>
            </MenuItem>
            <MenuItem Header="_3D Settings"/>
            <MenuItem Header="_Help">
                <MenuItem Header="System _Information" Command="{Binding ShowSystemInfoCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Tool Bar -->
        <ToolBarTray DockPanel.Dock="Top" Background="{StaticResource NvidiaWhiteBrush}">
            <ToolBar Background="{StaticResource NvidiaWhiteBrush}" Band="1" BandIndex="1">
                <Button Content="Back" Width="50" IsEnabled="False"/>
                <Button Content="Forward" Width="60" IsEnabled="False"/>
                <Separator/>
                <Label Content="Standard Tasks" FontWeight="Bold"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource NvidiaWhiteBrush}" BorderBrush="{StaticResource NvidiaDarkGreyBrush}" BorderThickness="0,1,0,0" Height="25">
            <StatusBarItem>
                <TextBlock Text="System Information: NVIDIA GeForce GTX 1650" Foreground="{StaticResource NvidiaDarkGreyBrush}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content (Split View) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Navigation Tree -->
            <Border Grid.Column="0" BorderBrush="#FFD0D0D0" BorderThickness="0,0,1,0" Background="White">
                <TreeView BorderThickness="0" Background="Transparent" Padding="5">
                    <TreeViewItem Header="3D Settings" IsExpanded="True" FontWeight="Bold">
                        <TreeViewItem Header="Adjust image settings with preview"/>
                        <TreeViewItem Header="Manage 3D settings" IsSelected="True">
                             <b:Interaction.Triggers>
                                <b:EventTrigger EventName="Selected">
                                    <b:InvokeCommandAction Command="{Binding NavigateCommand}" CommandParameter="Manage3DSettings"/>
                                </b:EventTrigger>
                             </b:Interaction.Triggers>
                        </TreeViewItem>
                        <TreeViewItem Header="Configure Surround, PhysX"/>
                    </TreeViewItem>
                    <TreeViewItem Header="Display" IsExpanded="True" FontWeight="Bold">
                        <TreeViewItem Header="Change resolution"/>
                        <TreeViewItem Header="Adjust desktop color settings"/>
                        <TreeViewItem Header="Rotate display"/>
                        <TreeViewItem Header="View HDCP status"/>
                        <TreeViewItem Header="Set up digital audio"/>
                        <TreeViewItem Header="Adjust desktop size and position"/>
                        <TreeViewItem Header="Set up multiple displays"/>
                    </TreeViewItem>
                    <TreeViewItem Header="Video" IsExpanded="True" FontWeight="Bold">
                        <TreeViewItem Header="Adjust video color settings"/>
                        <TreeViewItem Header="Adjust video image settings"/>
                    </TreeViewItem>
                </TreeView>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="#FFF0F0F0"/>

            <!-- Right Pane: Content -->
            <ContentControl Grid.Column="2" Content="{Binding CurrentView}" Margin="10"/>
        </Grid>
    </DockPanel>
</Window>
